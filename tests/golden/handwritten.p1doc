              },
              {
                "kind": "paragraph",
                "runs": [
                  { "text": "Mixed " },
                  { "text": "italic", "format": { "italic": true } },
                  { "text": ", " },
                  { "text": "underlined", "format": { "underline": true } },
                  { "text": ", " },
                  { "text": "struck", "format": { "strike": true } },
                  { "text": ", " },
